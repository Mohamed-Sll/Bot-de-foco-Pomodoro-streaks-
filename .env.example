# .env.example

# Telegram
BOT_TOKEN=
WEBHOOK_URL=https://o-teu-dominio.com
WEBHOOK_SECRET=

# Base de dados
# Dev:  sqlite:///focus_bot.db
# Prod: postgresql://user:pass@host:5432/focus_bot
DATABASE_URL=sqlite:///focus_bot.db

# Comportamento (todos opcionais, têm defaults em config.py)
DEFAULT_TIMEZONE=Atlantic/Cape_Verde
MIN_FOCUS_MINUTES=5
MAX_FOCUS_MINUTES=120
DEFAULT_BREAK_MINUTES=5
SWEEP_INTERVAL_SECONDS=60

# development | production
ENVIRONMENT=development